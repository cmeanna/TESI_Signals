        "        r'(expérience|expertise) de \\d+',  # francese\n",
        "    ]\n",
        "    return 1 if any(re.search(p, text, re.IGNORECASE) for p in patterns) else 0\n",
        "\n",
        "def detect_patent(text):\n",
        "    if not isinstance(text, str):\n",
        "        return 0\n",
        "    patterns = [\n",
        "        r'patent(ed|s|ing)?\\b',\n",
        "        r'patent (pending|filed|granted|application)',\n",
        "        r'proprietary (technology|tech|system|method|algorithm)',\n",
        "        r'trade(mark|secret)',\n",
        "        r'intellectual property',\n",
        "        r'patentiert', r'patentierte',  # tedesco\n",
        "        r'patentado', r'patente',       # spagnolo\n",
        "        r'breveté', r'brevet',          # francese\n",
        "        r'brevetto', r'brevettato',     # italiano\n",
        "    ]\n",
        "    return 1 if any(re.search(p, text, re.IGNORECASE) for p in patterns) else 0\n",
        "\n",
