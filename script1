        "import re\n",
        "\n",
        "def detect_patent(text):\n",
        "    if not isinstance(text, str):\n",
        "        return 0\n",
        "    patterns = [\n",
        "        r'patent', r'patented', r'patentiert', r'patentado',\n",
        "        r'proprietary technology', r'propriet[äa]re technologie',\n",
        "        r'intellectual property', r'geistiges eigentum',\n",
        "        r'trade secret', r'trademark', r'registered design',\n",
        "        r'utility model', r'gebrauchsmuster'\n",
        "    ]\n",
        "    return 1 if any(re.search(p, text, re.IGNORECASE) for p in patterns) else 0\n",
        "\n",
        "def detect_award(text):\n",
